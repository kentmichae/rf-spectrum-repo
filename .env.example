# RF-SOR Environment Configuration Template
# Copy to .env and fill in each field with your values.
# DO NOT commit .env to version control.

# --- Database ---
POSTGRES_USER=rf_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=rf_sor_db

# --- API ---
API_SECRET_KEY=CHANGE_ME
API_DEBUG=false
CORS_ORIGINS=http://localhost:3000

# --- Auth (Keycloak) ---
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=rf-sor-backend
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
